# ==========================================================
# Cloud IDE — Docker Compose Environment Variables Template
# ==========================================================
# Copy this file to .env and adjust credentials before running:
# cp .env.example .env

# MySQL Database Configuration
DB_NAME=cloud_ide
DB_USERNAME=cloudide
DB_PASSWORD=change-me-cloudide-password
DB_ROOT_PASSWORD=change-me-root-password

# JWT Secret & Security Configuration
# IMPORTANT: Replace with a secure 256-bit+ random secret in production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# Execution Worker Configuration
# Must be set to a secure, random secret (shared between backend and execution worker)
EXECUTION_WORKER_URL=http://host.docker.internal:8090
EXECUTION_WORKER_SECRET=replace-with-a-long-random-secret

# Application Ports
FRONTEND_PORT=5173
BACKEND_PORT=8088
